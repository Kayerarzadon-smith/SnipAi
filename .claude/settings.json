{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && ./scripts/qa --fast 2>&1 | grep -E $'\\033\\[31m' || true",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
