#!/bin/bash
# Everything that guards the cutting maths. No frameworks: Node 24 strips the
# types and runs the tests itself, Python uses unittest from the stdlib.
set -uo pipefail
cd "$(dirname "$0")/.." || exit 1

BOLD=$'\033[1m'; OK=$'\033[32m'; ERR=$'\033[31m'; DIM=$'\033[2m'; OFF=$'\033[0m'
fail=0

printf "\n%s== types ==%s\n" "$BOLD" "$OFF"
if npx tsc --noEmit -p tsconfig.json; then printf "  %sclean%s\n" "$OK" "$OFF"
else printf "  %sfailed%s\n" "$ERR" "$OFF"; fail=1; fi

printf "\n%s== app ==%s\n" "$BOLD" "$OFF"
if node --import ./tests/register.mts --test "tests/"*.test.mts 2>&1 \
     | grep -vE "MODULE_TYPELESS_PACKAGE_JSON|Reparsing as ES module|To eliminate this warning|trace-warnings"; then :
else fail=1; fi
# grep eats the exit code; ask node again, quietly
node --import ./tests/register.mts --test "tests/"*.test.mts >/dev/null 2>&1 || fail=1

printf "\n%s== pipeline ==%s\n" "$BOLD" "$OFF"
VENV=ugc-edit-system/.venv/bin/python
if [ ! -x "$VENV" ]; then
  printf "  %sskipped -- no venv at %s%s\n" "$DIM" "$VENV" "$OFF"
else
  ( cd ugc-edit-system && .venv/bin/python -m unittest discover -s tests -q ) || fail=1
fi

printf "\n"
if [ "$fail" = 0 ]; then printf "%s%sall green%s\n\n" "$BOLD" "$OK" "$OFF"
else printf "%s%ssomething is broken -- do not ship%s\n\n" "$BOLD" "$ERR" "$OFF"; fi
exit "$fail"
