#!/bin/bash
# Everything that guards the cutting maths. No frameworks: Node 24 strips the
# types and runs the tests itself, Python uses unittest from the stdlib.
set -uo pipefail
# PIPESTATUS below needs bash; the shebang already says so
cd "$(dirname "$0")/.." || exit 1

BOLD=$'\033[1m'; OK=$'\033[32m'; ERR=$'\033[31m'; DIM=$'\033[2m'; OFF=$'\033[0m'
fail=0

printf "\n%s== types ==%s\n" "$BOLD" "$OFF"
if npx tsc --noEmit -p tsconfig.json; then printf "  %sclean%s\n" "$OK" "$OFF"
else printf "  %sfailed%s\n" "$ERR" "$OFF"; fail=1; fi

printf "\n%s== app ==%s\n" "$BOLD" "$OFF"
# The node warning about a type-less package.json is noise on every file, but
# filtering it through a pipe hands grep's exit status to the shell instead of
# node's -- which is how this runner once cried failure over a green suite.
# PIPESTATUS keeps the answer that matters. Running the suite twice to recover
# it, as this used to, also ran every slow test twice.
node --import ./tests/register.mts --test "tests/"*.test.mts 2>&1 \
  | grep -vE "MODULE_TYPELESS_PACKAGE_JSON|Reparsing as ES module|To eliminate this warning|trace-warnings"
[ "${PIPESTATUS[0]}" = 0 ] || fail=1

# tests/regressions/ is the bug board, not the suite: a test there is written
# to FAIL until the bug it names is fixed, so it cannot gate this runner. It
# is counted, though -- "all green" meant nothing about the board, and the
# board is where the known defects live.
printf "\n%s== bug board ==%s\n" "$BOLD" "$OFF"
board=$(node --import ./tests/register.mts --test "tests/regressions/"*.test.mts 2>&1)
bpass=$(printf '%s\n' "$board" | sed -n 's/^.* pass \([0-9]*\)$/\1/p' | tail -1)
bfail=$(printf '%s\n' "$board" | sed -n 's/^.* fail \([0-9]*\)$/\1/p' | tail -1)
if [ "${bfail:-0}" = 0 ]; then printf "  %s%s fixed, none outstanding%s\n" "$OK" "${bpass:-0}" "$OFF"
else printf "  %s%s still open%s%s (%s fixed) -- ./scripts/qa --regressions\n" "$ERR" "$bfail" "$OFF" "$DIM" "${bpass:-0}"
     printf "%s" "$OFF"; fi

# Two things no unit test can see, because neither is a function: a review
# handler that forgets to schedule the re-render, and the desktop file chooser
# going missing. Both shipped once, both were invisible until someone tried to
# work in the app. scripts/qa ran the first of these with `|| true`, which
# meant it could report the bug and pass anyway.
printf "\n%s== guards ==%s\n" "$BOLD" "$OFF"
for g in scripts/guard-rebuild.py scripts/guard-open-panel.py; do
  python3 "$g" || fail=1
done

printf "\n%s== pipeline ==%s\n" "$BOLD" "$OFF"
VENV=ugc-edit-system/.venv/bin/python
if [ ! -x "$VENV" ]; then
  printf "  %sskipped -- no venv at %s%s\n" "$DIM" "$VENV" "$OFF"
else
  ( cd ugc-edit-system && .venv/bin/python -m unittest discover -s tests -q ) || fail=1
fi

printf "\n"
if [ "$fail" = 0 ]; then printf "%s%sall green%s\n\n" "$BOLD" "$OK" "$OFF"
else printf "%s%ssomething is broken -- do not ship%s\n\n" "$BOLD" "$ERR" "$OFF"; fi
exit "$fail"
