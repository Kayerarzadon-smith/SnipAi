#!/bin/bash
# Everything that guards the cutting maths. No frameworks: Node 24 strips the
# types and runs the tests itself, Python uses unittest from the stdlib.
set -uo pipefail
# PIPESTATUS below needs bash; the shebang already says so
cd "$(dirname "$0")/.." || exit 1

BOLD=$'\033[1m'; OK=$'\033[32m'; ERR=$'\033[31m'; DIM=$'\033[2m'; OFF=$'\033[0m'
WARN=$'\033[33m'
fail=0
# what did not run, so the final line cannot claim it did
skipped=""

# Collect what a killed run left behind, before starting (ledger T19). The
# scope argument lives in scripts/sweep-fixtures, which is a separate file so
# that tests/regressions/T19-*.test.mts can drive it against real decoys.
swept=$(./scripts/sweep-fixtures)
[ "${swept:-0}" -gt 0 ] && printf "%sswept %s leftover fixture dir(s) from a previous run%s\n" "$DIM" "$swept" "$OFF"

printf "\n%s== types ==%s\n" "$BOLD" "$OFF"
if npx tsc --noEmit -p tsconfig.json; then printf "  %sclean%s\n" "$OK" "$OFF"
else printf "  %sfailed%s\n" "$ERR" "$OFF"; fail=1; fi

printf "\n%s== app ==%s\n" "$BOLD" "$OFF"
# The node warning about a type-less package.json is noise on every file, but
# filtering it through a pipe hands grep's exit status to the shell instead of
# node's -- which is how this runner once cried failure over a green suite.
# PIPESTATUS keeps the answer that matters. Running the suite twice to recover
# it, as this used to, also ran every slow test twice.
node --import ./tests/register.mts --test "tests/"*.test.mts 2>&1 \
  | grep -vE "MODULE_TYPELESS_PACKAGE_JSON|Reparsing as ES module|To eliminate this warning|trace-warnings"
[ "${PIPESTATUS[0]}" = 0 ] || fail=1

# tests/regressions/ is the bug board, not the suite: a test there is written
# to FAIL until the bug it names is fixed, so it cannot gate this runner. It
# is counted, though -- "all green" meant nothing about the board, and the
# board is where the known defects live.
printf "\n%s== bug board ==%s\n" "$BOLD" "$OFF"
board=$(node --import ./tests/register.mts --test "tests/regressions/"*.test.mts 2>&1)
bpass=$(printf '%s\n' "$board" | sed -n 's/^.* pass \([0-9]*\)$/\1/p' | tail -1)
bfail=$(printf '%s\n' "$board" | sed -n 's/^.* fail \([0-9]*\)$/\1/p' | tail -1)
if [ "${bfail:-0}" = 0 ]; then printf "  %s%s fixed, none outstanding%s\n" "$OK" "${bpass:-0}" "$OFF"
else printf "  %s%s still open%s%s (%s fixed) -- ./scripts/qa --regressions\n" "$ERR" "$bfail" "$OFF" "$DIM" "${bpass:-0}"
     printf "%s" "$OFF"; fi

# Two things no unit test can see, because neither is a function: a review
# handler that forgets to schedule the re-render, and the desktop file chooser
# going missing. Both shipped once, both were invisible until someone tried to
# work in the app. scripts/qa ran the first of these with `|| true`, which
# meant it could report the bug and pass anyway.
printf "\n%s== guards ==%s\n" "$BOLD" "$OFF"
for g in scripts/guard-rebuild.py scripts/guard-open-panel.py scripts/guard-ledger.py; do
  python3 "$g" || fail=1
done

# The third thing no unit test can see, and the most expensive to be wrong
# about: the Swift rule that decides whether the app adopts a server already
# holding port 4737, or refuses because that server is serving a different
# library (ledger N1, P19). Nothing automated compiled it until 2026-09-11, so
# `decideLaunch` could have been changed to `.adopt` in every case and every
# gate would have stayed green until the next rebundle (ledger N4).
#
# It goes in THIS runner rather than in scripts/qa because this is the gate
# that runs on every push, and scripts/qa --full runs this file -- so one copy
# covers the push, the QA pass, and through scripts/qa's exit code
# scripts/bundle-app, which is the last gate before an artifact leaves the
# machine. In scripts/qa alone it would have caught a broken ownership rule
# only at bundle time, which is the lateness N4 is complaining about.
#
# ~14s of the runner's time. The thing it protects is footage that does not
# exist anywhere else.
printf "\n%s== launcher ==%s\n" "$BOLD" "$OFF"
./scripts/check-launcher || fail=1

printf "\n%s== pipeline ==%s\n" "$BOLD" "$OFF"
VENV=ugc-edit-system/.venv/bin/python
if [ ! -x "$VENV" ]; then
  printf "  %sskipped -- no venv at %s%s\n" "$DIM" "$VENV" "$OFF"
  skipped="$skipped the pipeline suite (no venv)"
else
  pyout=$( cd ugc-edit-system && .venv/bin/python -m unittest discover -s tests -q 2>&1 ) || fail=1
  printf "%s\n" "$pyout" | tail -3
  # unittest reports its own skips as "OK (skipped=N)". A test that declined to
  # run is not a test that passed, and this runner was calling both green.
  n=$(printf "%s" "$pyout" | sed -n 's/.*skipped=\([0-9]*\).*/\1/p' | tail -1)
  [ -n "${n:-}" ] && [ "$n" != 0 ] && skipped="$skipped $n pipeline test(s)"
fi

printf "\n"
if [ "$fail" != 0 ]; then
  printf "%s%ssomething is broken -- do not ship%s\n\n" "$BOLD" "$ERR" "$OFF"
elif [ -n "$skipped" ]; then
  # "all green" over a suite that never ran is the runner lying about its own
  # coverage. scripts/qa --full already said so; this one did not, and the two
  # disagreed about the same run.
  printf "%s%sgreen, but not everything ran:%s%s\n" "$BOLD" "$WARN" "$OFF" "$skipped"
  printf "  %s\"all green\" would have meant less than it looked%s\n\n" "$DIM" "$OFF"
else
  printf "%s%sall green%s\n\n" "$BOLD" "$OK" "$OFF"
fi
exit "$fail"
